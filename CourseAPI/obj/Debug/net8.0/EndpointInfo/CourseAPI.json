{
  "openapi": "3.0.1",
  "info": {
    "title": "CourseAPI",
    "version": "1.0"
  },
  "paths": {
    "/api/Course": {
      "get": {
        "tags": [
          "Course"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Course"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CourseDetail"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CourseDetail"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CourseDetail"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Course/{id}": {
      "delete": {
        "tags": [
          "Course"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CourseDetail": {
        "required": [
          "courseName",
          "technology"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "courseName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "technology": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "duration": {
            "type": "integer",
            "format": "int32"
          },
          "availabiltyStatus": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}